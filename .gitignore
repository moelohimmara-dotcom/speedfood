# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/apps/web/coverage

# next.js
/apps/web/.next/
/apps/web/out/

# production
/apps/web/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# cloudflare (déploiement via @opennextjs/cloudflare, voir docs/DEPLOIEMENT-CLOUDFLARE.md)
/apps/web/.open-next/
/apps/web/.wrangler/
.dev.vars
!.dev.vars.example

# typescript
*.tsbuildinfo
next-env.d.ts

# Clés de signature Android (jamais dans le dépôt)
*.keystore
*.jks
android/build/
android/.gradle/
android/app/build/
android/*.apk
android/*.aab
android/local.properties
android/*.idsig
android/*.apks
android/.idea/

# Résultat intermédiaire de la collecte ponctuelle des coordonnées
apps/web/scripts/.geocodage-quartiers.json

# Configuration Firebase (identifiants propres au projet Speedfood) : jamais dans le dépôt public.
mobile/androidApp/google-services.json

# iPhone : réglages locaux (adresse Supabase et clé publique), jamais dans Git
mobile/iosApp/Configuration/Secrets.xcconfig

# Dépendances de l espace de travail (racine, apps/*, packages/*)
node_modules/

# Ancien dossier web/ (avant le passage à apps/web), parfois recréé par un terminal resté ouvert
/web/
