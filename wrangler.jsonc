{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  // Nom distinct du projet Cloudflare Pages statique existant "speedfood"
  // (landing + prototype de démonstration) pour ne jamais les confondre.
  "name": "speedfood-app",
  "compatibility_date": "2026-09-27",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-reference nécessaire à OpenNext (voir https://opennext.js.org/cloudflare/caching).
      "binding": "WORKER_SELF_REFERENCE",
      "service": "speedfood-app"
    }
  ],
  // Workers AI — « Chef IA » (photo de menu → plats), voir src/lib/menu/chefIaModele.ts.
  // Binding sans clé d'API : l'inférence est incluse dans l'offre gratuite
  // (10 000 neurons/jour, ce qui couvre ~178 analyses de menu de 30 plats par
  // jour, pour une base de 8 restaurants). Le quota est par PROJET, pas par
  // restaurant : c'est la raison du limiteur par restaurant côté serveur.
  "ai": {
    "binding": "AI"
  },
  // Valeurs publiques uniquement (clé anon soumise aux policies RLS, sans
  // risque à exposer — voir .env.example). Les secrets réels (clé service-role,
  // clé de dérivation des jetons) sont configurés via `wrangler secret put`,
  // jamais ici : ce fichier est committé dans le dépôt.
  // Journalisation (Workers Logs). Inclus dans l'offre gratuite : 0,5 Go/jour et
  // 7 jours de rétention, l'ingestion s'arrêtant au plafond sans facturation
  // possible. Sans cela, aucune trace n'est conservée après coup — le plan
  // d'incident (docs/PLAN-INCIDENT.md) ne pouvait pas être appliqué.
  //
  // redact_query_string : le retour d'authentification Supabase passe un code à
  // usage unique dans la chaîne de requête de /auth/confirmation ; il n'a rien à
  // faire dans des journaux conservés sept jours. Contrepartie assumée : les
  // filtres d'URL (?statut=, ?jour=) n'apparaîtront plus dans les journaux.
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": {
      "invocation_logs": true,
      "persist": true
    }
  },
  "vars": {
    "NEXT_PUBLIC_SUPABASE_URL": "https://ggldjdizqrtpetdiohxy.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "sb_publishable_SlSk3qzeo4vqq-eJhQkB6A_3jeey8X8",
    "COMMANDE_PROPOSITION_DELAI_MINUTES": "30",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFMsB5gHaBVE2WkX",
    // Notifications push (lot A2) : clé PUBLIQUE et contact. La clé privée est le secret VAPID_PRIVATE_KEY (`wrangler secret put`).
    "VAPID_PUBLIC_KEY": "BEEl4ybkGK1EWJgNGJGXfr4g90A-L-p-lu9OYNPFbmmNIcfnZ-QMYdN9bUY7fg9ycnGydc7IBs8s64wz44h88KM",
    "VAPID_SUBJECT": "https://speedfood-app.moelohimmara.workers.dev"
  }
}
