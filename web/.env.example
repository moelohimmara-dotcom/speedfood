# Copier ce fichier en .env.local et renseigner les vraies valeurs. Ne jamais committer .env.local.
# Aucune valeur réelle ici — voir ADR-003 pour le choix de fournisseur (Supabase proposé, à confirmer).

# URL du projet Supabase (publique, sans risque à exposer au navigateur)
NEXT_PUBLIC_SUPABASE_URL=

# Clé anonyme Supabase (publique, soumise aux policies RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé service-role Supabase — SERVEUR UNIQUEMENT. Ne jamais préfixer NEXT_PUBLIC_,
# ne jamais l'envoyer au navigateur, ne jamais la logger (AGENT-INSTRUCTIONS.md).
SUPABASE_SERVICE_ROLE_KEY=

# --- Bloc 7 : commande et suivi ---
# Durée de validité d'une proposition révisée du restaurant, en minutes
# (1 à 1440 ; défaut 30 si la variable est absente ou invalide).
COMMANDE_PROPOSITION_DELAI_MINUTES=30

# Clé secrète de dérivation des jetons de suivi (HMAC-SHA256) — SERVEUR UNIQUEMENT.
# Optionnelle : SUPABASE_SERVICE_ROLE_KEY est utilisée si cette variable est absente.
COMMANDE_JETON_SECRET=

# --- Anti-robot (Cloudflare Turnstile), point 9 de la revue de sécurité ---
# Désactivé tant que le secret est absent. Les DEUX doivent être définis ensemble.
# Clé de site : publique (variable du Worker dans wrangler.jsonc). Secret : SERVEUR UNIQUEMENT
# (`npx wrangler secret put TURNSTILE_SECRET_KEY`), jamais dans le dépôt.
# Clés de test publiées par Cloudflare pour le développement local :
#   site 1x00000000000000000000AA / secret 1x0000000000000000000000000000000AA (toujours valides)
#   secret 2x0000000000000000000000000000000AA (toujours refusé)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Paiement en ligne (lot P3) : éteint par défaut (table parametres_paiement), voir docs/PAIEMENT-ARCHITECTURE.md ---
# Clé de signature des notifications SIMULÉES (16 caractères au moins) — SERVEUR UNIQUEMENT (`npx wrangler secret put`).
# Sans elle, la simulation refuse de démarrer : le dépôt est public, une clé par défaut permettrait de forger un paiement.
PAIEMENT_SIMULATION_CLE=
# Chap Chap Pay (lot P5, adaptateur non implémenté) — SERVEUR UNIQUEMENT. Clés de test d'abord.
# Secret de la tâche planifiée d'entretien (16 caractères au moins) — SERVEUR UNIQUEMENT. Sans lui, l'entretien ne s'exécute pas.
PAIEMENT_ENTRETIEN_SECRET=
CHAPCHAP_CLE_API=
CHAPCHAP_CLE_SIGNATURE=

# Redis (Upstash, facultatif) : limitation de débit sur Redis, avec repli sur la base. Sans ces deux variables, tout reste dans la base. Secrets du Worker, jamais commités.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# LIMITEUR_REDIS=non   # interrupteur de secours : coupe Redis sans retirer les secrets
# UPSTASH_QUOTA_MENSUEL=500000
