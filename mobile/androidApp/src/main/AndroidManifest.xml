<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Espace livreur : position lue seulement pendant que l'application est ouverte (lot N4a). -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- Suivi du livreur application fermée (lot N4b) : service au premier plan de type position, notification permanente, processeur éveillé pendant le suivi. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- Alerte de commande application fermée (restaurateur) : service au premier plan d'usage spécial (sondage des commandes), sans limite de durée. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:name=".SpeedfoodApp"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Speedfood">
        <!-- Notifications poussées : le texte est affiché par le système ; ce service ne sert qu'à renouveler le jeton de l'appareil. -->
        <service
            android:name=".SpeedfoodMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="suivi_commande" />
        <service
            android:name=".SurveillanceRestaurateurService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Surveillance des nouvelles commandes d'un restaurant pour l'alerter, à sa demande" />
        </service>
        <service
            android:name=".SuiviLivreurService"
            android:exported="false"
            android:foregroundServiceType="location" />
        <activity
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
