{
  "expo": {
    "name": "Speedfood Catalogue",
    "slug": "speedfood-client-demo",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/speedfood.png",
    "scheme": "speedfood-demo",
    "userInterfaceStyle": "light",
    "platforms": [
      "android",
      "ios",
      "web"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.speedfood.clientdemo"
    },
    "android": {
      "package": "com.speedfood.clientdemo",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": false,
          "data": [
            { "scheme": "https", "host": "speedfood.dev", "pathPrefix": "/r/" },
            { "scheme": "https", "host": "speedfood.dev", "pathPrefix": "/commande/" },
            { "scheme": "https", "host": "www.speedfood.dev", "pathPrefix": "/r/" },
            { "scheme": "https", "host": "www.speedfood.dev", "pathPrefix": "/commande/" },
            { "scheme": "https", "host": "speedfood-app.moelohimmara.workers.dev", "pathPrefix": "/r/" },
            { "scheme": "https", "host": "speedfood-app.moelohimmara.workers.dev", "pathPrefix": "/commande/" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "blockedPermissions": ["android.permission.READ_EXTERNAL_STORAGE"],
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/speedfood.png",
        "backgroundColor": "#FFF6ED"
      }
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/speedfood.png"
    },
    "plugins": [
      "expo-secure-store",
      ["expo-local-authentication", { "faceIDPermission": "Speedfood utilise la reconnaissance faciale pour verrouiller vos espaces professionnels." }],
      "expo-router",
      ["expo-notifications", { "color": "#B82A20" }],
      [
        "expo-image-picker",
        {
          "photosPermission": "Speedfood utilise vos photos pour illustrer les plats du menu.",
          "cameraPermission": "Speedfood utilise l'appareil photo pour photographier vos plats.",
          "microphonePermission": false
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFF6ED",
          "image": "./assets/images/speedfood.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}
